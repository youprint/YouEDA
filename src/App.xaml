<Application x:Class="EasyEdaAltiumGrabber.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#353535"/><SolidColorBrush x:Key="Panel" Color="#414141"/><SolidColorBrush x:Key="PanelDark" Color="#252525"/><SolidColorBrush x:Key="Accent" Color="#5E88A8"/><SolidColorBrush x:Key="AccentHover" Color="#7299B7"/>
  <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="#F2F2F2"/></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F3F3F3"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#272727"/><Setter Property="BorderBrush" Value="#1C1C1C"/><Setter Property="Padding" Value="9,6"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="White"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Background" Value="#4A4A4A"/><Setter Property="BorderBrush" Value="#252525"/><Setter Property="Padding" Value="18,8"/><Setter Property="Margin" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#5A5A5A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></Style.Triggers></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="#343434"/><Setter Property="Foreground" Value="#F1F1F1"/><Setter Property="BorderBrush" Value="#1E1E1E"/><Setter Property="RowBackground" Value="#343434"/><Setter Property="AlternatingRowBackground" Value="#393939"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#464646"/><Setter Property="VerticalGridLinesBrush" Value="#464646"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#484848"/><Setter Property="Foreground" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#2C2C2C"/><Setter Property="Padding" Value="7,4"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,4"/><Setter Property="Foreground" Value="#F1F1F1"/></Style>
 </Application.Resources>
</Application>
