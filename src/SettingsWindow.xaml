<Window x:Class="EasyEdaAltiumGrabber.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="YouEDA Settings" Width="580" Height="670" MinWidth="490" MinHeight="430"
 WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Bg}">
 <Grid Margin="22">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,12,0">
    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,6"/>
    <TextBlock Text="Changes apply immediately. Import options are locked while a job is running."
     TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,18"/>
    <StackPanel IsEnabled="{Binding CanChangeDiagnostics}">
     <TextBlock Text="Import" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <CheckBox x:Name="RefreshCadOption" Content="Refresh CAD from server (ignore fresh cache)"
      IsChecked="{Binding RefreshCadFromServer, Mode=TwoWay}"/>
     <TextBlock Text="Usually leave this off: validated CAD is reused for 7 days. Refresh downloads every component again and can take several minutes. This option resets when YouEDA restarts."
      TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,12"/>
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="Altium family workers" VerticalAlignment="Center" Margin="0,0,14,0"/>
      <ComboBox x:Name="FamilyWorkerSelector" Width="70" ItemsSource="{Binding FamilyWorkerOptions}"
       SelectedItem="{Binding FamilyWorkerCount, Mode=TwoWay}"/>
     </StackPanel>
     <TextBlock Text="3 workers by default; use 1 for comparison. Shared network limits are unchanged. Resets to 3 when YouEDA restarts."
      TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,12"/>
    </StackPanel>
    <TextBlock Text="Full import always creates combined and family-based libraries without an organization prompt. Necessary symbol selections still apply."
     TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,18"/>
    <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <CheckBox x:Name="DiagnosticLoggingOption" Content="Generate diagnostic logs"
     IsChecked="{Binding DiagnosticLogging, Mode=TwoWay}" IsEnabled="{Binding CanChangeDiagnostics}"/>
    <TextBlock Text="Saved for future runs. Local logs contain part IDs, paths, timings, and errors—not raw CAD/STEP data or request headers. Nothing is uploaded."
     TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,10"/>
    <WrapPanel Margin="0,0,0,18">
     <Button Content="Open logs" Command="{Binding OpenDiagnosticLogsCommand}" Padding="10,5"/>
     <TextBlock Text="{Binding DiagnosticLogStatus}" ToolTip="{Binding LastDiagnosticLog}"
      VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0"/>
    </WrapPanel>
    <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <ComboBox x:Name="AppearanceSelector" ItemsSource="{Binding AvailableThemes}"
     SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"/>
   </StackPanel>
  </ScrollViewer>
  <Button Grid.Row="1" Content="Done" IsCancel="True" IsDefault="True" Click="CloseSettings"
   HorizontalAlignment="Right" MinWidth="95" Margin="0,16,0,0" Background="{DynamicResource Accent}"/>
 </Grid>
</Window>
