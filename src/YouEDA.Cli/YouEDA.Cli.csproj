<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>YouEDA.Cli</AssemblyName>
    <RootNamespace>YouEDA.Cli</RootNamespace>
    <AltiumSharpRoot Condition="'$(AltiumSharpRoot)' == ''">$(MSBuildProjectDirectory)\..\..\third_party\AltiumSharp</AltiumSharpRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(AltiumSharpRoot)\src\OriginalCircuit.Altium\OriginalCircuit.Altium.csproj" />
    <ProjectReference Include="$(AltiumSharpRoot)\shared\OriginalCircuit.Eda.Abstractions\src\OriginalCircuit.Eda.Abstractions\OriginalCircuit.Eda.Abstractions.csproj" />

    <!-- Reuse the production parser/exporter so GUI and CLI create the same native libraries. -->
    <Compile Include="..\Models\**\*.cs" Link="Models\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Services\AltiumSchExporter.cs" Link="Services\AltiumSchExporter.cs" />
    <Compile Include="..\Services\AltiumV2Exporter.cs" Link="Services\AltiumV2Exporter.cs" />
    <Compile Include="..\Services\BulkLibraryWriter.cs" Link="Services\BulkLibraryWriter.cs" />
    <Compile Include="..\Services\EasyEda3dModelDownloader.cs" Link="Services\EasyEda3dModelDownloader.cs" />
    <Compile Include="..\Services\LcscScraper.cs" Link="Services\LcscScraper.cs" />
    <Compile Include="..\Services\LibraryExporter.cs" Link="Services\LibraryExporter.cs" />
    <Compile Include="..\Services\KiCadLibraryExporter.cs" Link="Services\KiCadLibraryExporter.cs" />
    <Compile Include="..\Services\Parser.cs" Link="Services\Parser.cs" />
    <Compile Include="..\Services\UserSymbolLibraryResolver.cs" Link="Services\UserSymbolLibraryResolver.cs" />

    <Content Include="$(AltiumSharpRoot)\TestData\PCB - DIODES - DIODES INC SDT10A45P5.PCBLIB" Link="Templates\AltiumTemplate.PcbLib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Assets\BundledUserSymbols.SchLib" Link="Symbols\BundledUserSymbols.SchLib" Condition="Exists('..\Assets\BundledUserSymbols.SchLib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
