<Window x:Class="EasyEdaAltiumGrabber.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:EasyEdaAltiumGrabber.Controls" Title="YouEDA — EasyEDA / LCSC Component Loader" Width="1320" Height="820" MinWidth="1020" MinHeight="650" WindowStartupLocation="CenterScreen" WindowState="Maximized" Background="{DynamicResource Bg}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/></Window.Resources>
 <Grid Margin="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,8,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Search component library" FontSize="16" FontWeight="SemiBold"/>
      <Border Background="{DynamicResource PanelDark}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="3" Margin="14,0,0,0" Padding="8,3"><TextBlock Text="EasyEDA" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></Border>
      <Border Background="{DynamicResource PanelDark}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" CornerRadius="3" Margin="6,0,0,0" Padding="8,3"><TextBlock Text="LCSC" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/></Border>
     </StackPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="PartNumberBox" Text="{Binding PartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Background="{DynamicResource Accent}"/></Grid>
    </StackPanel>
    <Button x:Name="SettingsButton" Grid.Column="1" Content="Settings…" Click="OpenSettings" VerticalAlignment="Bottom" Margin="12,0,0,0" ToolTip="Import, diagnostics, and appearance settings"/>
   </Grid>
   <Border Grid.Row="1" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Margin="0,12,0,12" Padding="10">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Batch input (paste LCSC references separated by commas, spaces, or new lines)" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,5"/>
      <TextBox Text="{Binding BatchPartNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
      <TextBlock Text="{Binding ImportSettingsSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,6,0,0" ToolTip="Change these options with Settings…"/>
     </StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
      <Button Content="Import CSV" Command="{Binding ImportCsvCommand}" ToolTip="Load LCSC references from a CSV or text file" Margin="0,0,0,6"/>
      <Button x:Name="RunFullImportButton" Content="Run full import" Command="{Binding RunFullImportCommand}" Padding="6,8" Background="{DynamicResource Accent}" ToolTip="For the loaded CSV: search and pricing, then automatically generate combined and family-based libraries in the selected Altium/KiCad output folder, without an organization prompt. Includes available footprints and 3D unless you already deselected them. Necessary symbol choices still apply. Stopping search prevents automatic export."/>
     </StackPanel>
    </Grid>
   </Border>
   <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="False" AlternatingRowBackground="#393939"><DataGrid.Columns><DataGridCheckBoxColumn Header="FP" Binding="{Binding IncludeFootprint, Mode=TwoWay}" Width="42"/><DataGridCheckBoxColumn Header="3D" Binding="{Binding Include3D, Mode=TwoWay}" Width="42"/><DataGridTextColumn Header="LCSC" Binding="{Binding PartNumber}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
   <StackPanel Grid.Row="3" Margin="0,0,0,4" Visibility="{Binding ShowProgress, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="Stop search — keep downloaded parts" Command="{Binding CancelSearchCommand}" HorizontalAlignment="Left" Margin="0,5,0,5"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/><TextBlock x:Name="ImportSpeedIndicator" Text="{Binding SpeedText}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,6"/><ProgressBar Height="8" Minimum="0" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" Foreground="{DynamicResource Accent}"/></StackPanel>
   <TabControl Grid.Row="4" MinHeight="164" Margin="0,12,0,0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource InputBorder}" SelectedIndex="{Binding SelectedExportTab, Mode=TwoWay}">
    <TabControl.Resources>
     <Style TargetType="{x:Type TabItem}">
      <Setter Property="Background" Value="{DynamicResource PanelDark}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
      <Setter Property="Padding" Value="12,5"/><Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
      <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type TabItem}"><Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" ContentTemplate="{TemplateBinding HeaderTemplate}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
     </Style>
    </TabControl.Resources>
    <TabItem Header="Altium">
     <Border Background="{DynamicResource Panel}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="Altium output directory" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/><TextBlock Text="ALTIUM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="10,1,0,0"/></StackPanel><TextBox Text="{Binding AltiumOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
       <Button Content="Open folder" Command="{Binding OpenAltiumOutputCommand}"/>
       <Button Content="Open in Altium" Command="{Binding OpenAltiumLibrariesCommand}" ToolTip="Open youeda.PcbLib and youeda.SchLib in Altium Designer" Margin="8,0,0,0"/>
       <Button Content="Save source" Command="{Binding SaveAltiumSourceCommand}" ToolTip="Save the selected EasyEDA component payload" Margin="8,0,0,0"/>
       <Button Content="Add selected to Altium library" Command="{Binding AddToAltiumCommand}" Background="{DynamicResource Accent}" Margin="8,0,0,0"/>
      </StackPanel>
     </Grid></Border>
    </TabItem>
    <TabItem Header="KiCad">
     <Border Background="{DynamicResource Panel}" Padding="10"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="KiCad output directory" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/><TextBlock Text="KiCad" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Accent}" Margin="10,1,0,0"/></StackPanel><TextBox Text="{Binding KiCadOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
       <Button Content="Open folder" Command="{Binding OpenKiCadOutputCommand}"/>
       <Button Content="Save source" Command="{Binding SaveKiCadSourceCommand}" ToolTip="Save the selected EasyEDA component payload" Margin="8,0,0,0"/>
       <Button Content="Add selected to KiCad library" Command="{Binding AddToKiCadCommand}" Background="{DynamicResource Accent}" Margin="8,0,0,0"/>
      </StackPanel>
     </Grid></Border>
    </TabItem>
   </TabControl>
  </Grid>
  <Border Grid.Column="1" Background="{DynamicResource PanelDark}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="145"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Preview" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"><controls:SymbolPreviewControl Component="{Binding PreviewComponent}"/></Border><TextBlock Grid.Row="2" Text="Footprint" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,7"/><Border Grid.Row="3" Background="{DynamicResource PreviewBackground}" BorderBrush="{DynamicResource InputBorder}" BorderThickness="1"><controls:FootprintPreviewControl Component="{Binding PreviewComponent}"/></Border><TextBlock Grid.Row="4" Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" Margin="0,12,0,2"/></Grid></Border>
 </Grid>
</Window>
