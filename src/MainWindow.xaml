<Window x:Class="EasyEdaAltiumGrabber.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:EasyEdaAltiumGrabber.Controls" Title="YouEDA — EasyEDA / LCSC Component Loader" Width="1320" Height="820" MinWidth="1020" MinHeight="650" Background="{StaticResource Bg}">
 <Grid Margin="15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="410"/></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Margin="0,0,14,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="Enter LCSC part number to search (e.g. C2040):" FontSize="14" Margin="0,8,0,8"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="PartNumberBox" Text="{Binding PartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/><Button Grid.Column="2" Content="Search" Command="{Binding SearchCommand}" Background="{StaticResource Accent}"/></Grid></StackPanel>
   <Border Grid.Row="1" Background="#3E3E3E" BorderBrush="#252525" BorderThickness="1" Margin="0,12,0,12" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Batch input (paste LCSC references separated by commas, spaces, or new lines)" Foreground="#D7D7D7" Margin="0,0,0,5"/><TextBox Text="{Binding BatchPartNumbers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel><Button Grid.Column="2" VerticalAlignment="Bottom" Content="Import CSV" Command="{Binding ImportCsvCommand}" ToolTip="Load LCSC references from a CSV or text file"/></Grid></Border>
   <DataGrid Grid.Row="2" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="False" AlternatingRowBackground="#393939"><DataGrid.Columns><DataGridCheckBoxColumn Header="FP" Binding="{Binding IncludeFootprint, Mode=TwoWay}" Width="42"/><DataGridCheckBoxColumn Header="3D" Binding="{Binding Include3D, Mode=TwoWay}" Width="42"/><DataGridTextColumn Header="LCSC" Binding="{Binding PartNumber}" Width="90" IsReadOnly="True"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="Package" Binding="{Binding Package}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
   <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Output directory" Foreground="#D7D7D7" Margin="0,0,0,4"/><TextBox Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Schematic symbols" Foreground="#D7D7D7" Margin="0,8,0,2"/><TextBlock Text="Your Altium symbol collection is bundled inside this application and matched automatically." Foreground="#9FC8E8" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="2" VerticalAlignment="Bottom" Content="Open folder" Command="{Binding OpenOutputCommand}"/><Button Grid.Column="4" VerticalAlignment="Bottom" Content="Open in Altium" Command="{Binding OpenInAltiumCommand}" ToolTip="Open youeda.PcbLib and youeda.SchLib in Altium Designer"/><Button Grid.Column="6" VerticalAlignment="Bottom" Content="Save source" Command="{Binding SaveModelCommand}" ToolTip="Save the selected EasyEDA component payload"/><Button Grid.Column="8" VerticalAlignment="Bottom" Content="Add selected to library" Command="{Binding AddToLibraryCommand}" Background="{StaticResource Accent}"/></Grid>
  </Grid>
  <Border Grid.Column="1" Background="#282828" BorderBrush="#1D1D1D" BorderThickness="1" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="145"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Preview" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><Border Grid.Row="1" Background="White" BorderBrush="#1B1B1B" BorderThickness="1"><controls:SymbolPreviewControl Component="{Binding PreviewComponent}"/></Border><TextBlock Grid.Row="2" Text="Footprint" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,7"/><Border Grid.Row="3" Background="#111111" BorderBrush="#1B1B1B" BorderThickness="1"><controls:FootprintPreviewControl Component="{Binding PreviewComponent}"/></Border><TextBlock Grid.Row="4" Text="{Binding StatusText, Mode=OneWay}" TextWrapping="Wrap" Foreground="#CFCFCF" Margin="0,12,0,2"/></Grid></Border>
 </Grid>
</Window>
